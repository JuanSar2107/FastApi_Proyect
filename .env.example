# Copia este archivo a .env y ajusta los valores.
PORT=5050
DATABASE_URL=sqlite:///./inventario.db
SECRET_KEY=cambia-esta-clave-en-produccion

# Orígenes permitidos para CORS, separados por comas, sin barra final.
# No uses "*": la API tiene allow_credentials=True y esa combinación no es válida.
CORS_ORIGINS=https://flutter.proyecto.lol,https://www.flutter.proyecto.lol,http://localhost:8044,http://127.0.0.1:8044
